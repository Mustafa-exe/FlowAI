rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own data (all subcollections)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Username reservation — anyone authenticated can read (for uniqueness check)
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Registered users — written by server-side API routes only.
    // Clients cannot read other users' password hashes.
    // Each user can read their own doc (for profile display).
    match /registeredUsers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Writes only from authenticated server context (API routes use admin SDK or Firebase Auth)
      allow write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
